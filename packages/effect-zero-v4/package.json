{
  "name": "@awstin/effect-zero-v4",
  "version": "0.2.0-beta.3",
  "description": "Beta-track Zero DBConnection scaffold for Effect v4.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./openapi": {
      "types": "./dist/openapi.d.mts",
      "default": "./dist/openapi.mjs"
    },
    "./openapi/elysia": {
      "types": "./dist/openapi/elysia.d.mts",
      "default": "./dist/openapi/elysia.mjs"
    },
    "./openapi/hono": {
      "types": "./dist/openapi/hono.d.mts",
      "default": "./dist/openapi/hono.mjs"
    },
    "./openapi/zod": {
      "types": "./dist/openapi/zod.d.mts",
      "default": "./dist/openapi/zod.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./timestamps": {
      "types": "./dist/timestamps.d.mts",
      "default": "./dist/timestamps.mjs"
    },
    "./server/adapters/drizzle": {
      "types": "./dist/server/adapters/drizzle.d.mts",
      "default": "./dist/server/adapters/drizzle.mjs"
    },
    "./server/adapters/pg": {
      "types": "./dist/server/adapters/pg.d.mts",
      "default": "./dist/server/adapters/pg.mjs"
    },
    "./server/adapters/postgresjs": {
      "types": "./dist/server/adapters/postgresjs.d.mts",
      "default": "./dist/server/adapters/postgresjs.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepack": "vp pack",
    "test": "vp test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.59",
    "@effect/sql-pg": "4.0.0-beta.59",
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@effect-zero/example-data": "workspace:*",
    "@effect-zero/test-utils": "workspace:*",
    "@effect-zero/tsconfig": "workspace:*",
    "@elysiajs/openapi": "^1.4.15",
    "@rocicorp/zero": "1.5.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@typescript/native-preview": "7.0.0-dev.20260503.1",
    "bumpp": "^11.0.1",
    "drizzle-orm": "1.0.0-rc.1",
    "effect": "4.0.0-beta.59",
    "elysia": "^1.4.28",
    "hono": "^4.12.16",
    "pg": "8.20.0",
    "postgres": "3.4.7",
    "tsdown": "0.21.10",
    "typescript": "^6.0.3",
    "vite-plus": "0.1.20",
    "vitest": "0.1.20",
    "zod": "4.4.2"
  },
  "peerDependencies": {
    "@rocicorp/zero": ">=1.0.0 <2",
    "drizzle-orm": "1.0.0-rc.1",
    "effect": "4.0.0-beta.59",
    "elysia": "^1.4.28",
    "hono": "^4.12.12",
    "pg": "8.20.0",
    "postgres": ">=3 <4",
    "zod": "^4.1.5"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "elysia": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
