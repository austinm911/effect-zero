{
  "name": "@effect-zero/example-api",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable Node harness for effect-zero runtime and adapter verification.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "HOST=localhost PORT=4311 pnpm exec tsx watch src/server.ts",
    "start": "pnpm exec tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@awstin/effect-zero-v3": "workspace:*",
    "@awstin/effect-zero-v4": "workspace:*",
    "@effect-zero/example-data": "workspace:*",
    "@effect-zero/test-utils": "workspace:*",
    "@hono/node-server": "^1.19.14",
    "@rocicorp/zero": "1.8.0",
    "drizzle-orm": "0.45.2",
    "effect": "3.21.2",
    "effect-v4": "npm:effect@4.0.0-beta.83",
    "hono": "^4.12.29",
    "pg": "8.20.0",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@effect-zero/tsconfig": "workspace:*",
    "@types/node": "24.12.2",
    "tsx": "^4.23.0",
    "typescript": "6.0.3"
  }
}
