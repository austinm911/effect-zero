{
  "name": "effect-zero",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "examples/*",
      "infra/*",
      "packages/*",
      "tools/*"
    ],
    "catalog": {
      "@cloudflare/vite-plugin": "1.27.0",
      "@cloudflare/workers-types": "^4.20260313.1",
      "@rocicorp/zero": "1.1.1",
      "@tanstack/react-router": "1.166.7",
      "@tanstack/react-start": "1.166.7",
      "@tanstack/router-cli": "1.166.7",
      "@types/node": "^24",
      "@vitejs/plugin-react": "^5.1.4",
      "alchemy": "0.87.0",
      "drizzle-kit": "0.31.1",
      "drizzle-orm": "0.44.1",
      "drizzle-zero": "0.17.4",
      "postgres": "3.4.7",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "sonner": "^2.0.7",
      "tsdown": "^0.21.2",
      "typescript": "^5",
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vite-plus": "latest",
      "vite-tsconfig-paths": "^6.1.1",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
      "wrangler": "^4.72.0",
      "zod": "^4.1.5"
    }
  },
  "type": "module",
  "scripts": {
    "bench:api": "pnpm exec tsx benchmarks/run-api-benchmarks.mjs",
    "bench:api:quick": "pnpm exec tsx benchmarks/run-api-benchmarks.mjs --samples 1",
    "build": "vp run build -r",
    "check": "vp fmt . --check && vp lint",
    "dev": "vp run --workspace-root stack:web",
    "dev:api": "vp run --workspace-root stack:api",
    "dev:db": "pnpm --filter @effect-zero/alchemy dev",
    "dev:stack": "vp run --workspace-root stack:dev",
    "dev:zero": "vp run --workspace-root stack:zero",
    "desloppify:setup": "node tools/desloppify-setup.mjs",
    "desloppify:scan": "pnpm desloppify:setup && desloppify scan --path .",
    "desloppify:status": "desloppify status",
    "desloppify:queue": "node tools/desloppify-queue.mjs",
    "db:push": "pnpm --filter @effect-zero/example-data db:push",
    "fmt:fix": "vp fmt . --write",
    "pack:package": "node tools/pack-package.mjs",
    "pack:v3": "node tools/pack-package.mjs packages/effect-zero-v3",
    "pack:v4": "node tools/pack-package.mjs packages/effect-zero-v4",
    "pack:all": "node tools/pack-package.mjs packages/effect-zero-v3 packages/effect-zero-v4",
    "ready": "pnpm check && vp run test -r && vp run build -r",
    "release:check": "pnpm ready && vp run verify:client-entrypoints && node tools/check-package-installs.mjs",
    "release:version": "node tools/release-package.mjs",
    "seed:ztunes": "node tools/load-ztunes-seed.mjs",
    "publish:package": "node tools/publish-package.mjs",
    "publish:v3": "node tools/publish-package.mjs packages/effect-zero-v3",
    "publish:v4": "node tools/publish-package.mjs packages/effect-zero-v4",
    "publish:v4:beta": "node tools/publish-package.mjs packages/effect-zero-v4 --tag beta",
    "test": "vp run test -r",
    "verify:client-entrypoints": "node tools/check-client-entrypoints.mjs",
    "verify:api": "pnpm exec tsx tools/verify-api-targets.mjs",
    "verify:api:package": "VERIFY_API_BASE_URL=http://localhost:4311 pnpm exec tsx tools/verify-api-targets.mjs --target control,v3-drizzle,v3-pg,v3-postgresjs,v4-drizzle,v4-pg,v4-postgresjs",
    "verify:mutation-stress": "pnpm exec tsx tools/verify-mutation-stress.mjs",
    "verify:mutation-stress:package": "VERIFY_API_BASE_URL=http://localhost:4311 pnpm exec tsx tools/verify-mutation-stress.mjs --target control,v3-drizzle,v3-pg,v3-postgresjs,v4-drizzle,v4-pg,v4-postgresjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.35.0",
    "@cloudflare/workers-types": "4.20260503.1",
    "@effect-zero/tsconfig": "workspace:*",
    "tsx": "^4.20.5",
    "vite-plus": "0.1.20"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.32.1",
  "examples/api": {
    "devDependencies": {
      "@cloudflare/vite-plugin": {
        "specifier": "catalog:",
        "version": "1.27.0(vite@8.0.0(@types/node@25.5.0)(esbuild@0.27.4)(jiti@2.6.1)(tsx@4.21.0)(yaml@2.8.3))(workerd@1.20260312.1)(wrangler@4.73.0(@cloudflare/workers-types@4.20260313.1))"
      },
      "@cloudflare/workers-types": {
        "specifier": "catalog:",
        "version": "4.20260313.1"
      },
      "@effect-zero/tsconfig": {
        "specifier": "workspace:*",
        "version": "link:packages/tsconfig"
      },
      "tsx": {
        "specifier": "^4.20.5",
        "version": "4.21.0"
      },
      "vite-plus": {
        "specifier": "catalog:",
        "version": "0.1.11(@opentelemetry/api@1.9.0)(@types/node@25.5.0)(esbuild@0.27.4)(jiti@2.6.1)(tsx@4.21.0)(typescript@5.9.3)(vite@8.0.0(@types/node@25.5.0)(esbuild@0.27.4)(jiti@2.6.1)(tsx@4.21.0)(yaml@2.8.3))(yaml@2.8.3)"
      }
    }
  }
}
